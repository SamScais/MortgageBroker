# Local demo only — not a production deployment.
# Copy to .env.local if you want to override defaults.

# Used to sign the broker session cookie. Change before any shared hosting.
SESSION_SECRET=demo-only-session-secret-change-me

# Shown on copied client links. Default is fine for local use.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional overrides (defaults are ./data/db.json and ./data/uploads)
# DATABASE_PATH=./data/db.json
# UPLOAD_DIR=./data/uploads
