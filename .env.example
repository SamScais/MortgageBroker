# Local demo or private Vercel preview — not a production deployment.
# Copy to .env.local for local overrides.

# Used to sign the broker session cookie. Change before any shared hosting.
SESSION_SECRET=demo-only-session-secret-change-me

# Shown on copied client links. Leave unset on Vercel preview so the
# deployment hostname (VERCEL_URL) is used automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional path overrides (defaults: ./data locally, /tmp/mortgage-broker-intake on Vercel)
# DATA_DIR=./data
# DATABASE_PATH=./data/db.json
# UPLOAD_DIR=./data/uploads
